{
  "editor.formatOnSave": true,
  "go.toolsEnvVars": {
    "GOFLAGS": "-tags=small,medium,scenario"
  },
  "[typescript]": {
    "editor.formatOnSave": true
  },
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--path-mode=abs",
    "--fast-only"
  ],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint"
  },
  "go.formatFlags": [
    "fmt",
    "--stdin"
  ],
  "files.exclude": {
    "~/.cache/**": true,
    "bazel-*/**": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "~/.cache/**": true,
    "bazel-*/**": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  }
}